# Copia este archivo como .env (queda fuera de Git). Deja vacío lo que no uses.
# Las claves también se pueden escribir en el panel en cada sesión; es lo recomendado.

# NVIDIA Build: tu clave personal (empieza con nvapi-). No la compartas.
NVIDIA_API_KEY=
NVIDIA_MODELO=nvidia/nemotron-3-ultra-550b-a55b

# Cloudflare Workers AI (imágenes). Tu propia cuenta gratuita.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Codex: usa la sesión local de tu ChatGPT. Solo la ruta al ejecutable si no está en PATH.
CODEX_RUTA=

# Headroom (opcional)
HEADROOM_OFFLINE=1
HEADROOM_MIN_CARACTERES=6000

# Nodo: alias público para tus resultados (no tu nombre real si no quieres)
NODO_ALIAS=
